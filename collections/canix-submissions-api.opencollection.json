{
  "opencollection": "1.0.0",
  "info": {
    "name": "Canix Submissions API",
    "version": "1.3.10"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Submissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetSubmission",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canix.com/api/v1/submissions/:submission_id",
            "params": [
              {
                "name": "submission_id",
                "value": "U3VibWlzc2lvbjo0NTY3ODk=",
                "type": "path",
                "description": "Submission UUID"
              }
            ]
          },
          "docs": "Get Submission by ID. A submission represents an asynchronous action (such as creating a package,\nadjusting inventory, submitting a transfer, etc.) that may be pending, successful, failed, or\nrequire approval. Use this endpoint to poll the status of a submission after initiating an action.\n"
        }
      ]
    }
  ],
  "bundled": true
}