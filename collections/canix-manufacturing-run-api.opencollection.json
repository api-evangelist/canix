{
  "opencollection": "1.0.0",
  "info": {
    "name": "Canix Manufacturing Run API",
    "version": "1.3.10"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manufacturing Run",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetManuBatchRuns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canix.com/api/v1/manu_batch_runs"
          },
          "docs": "Get All Manufacturing Runs"
        },
        {
          "info": {
            "name": "GetManuBatchRun",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canix.com/api/v1/manu_batch_runs/:manu_batch_run_id",
            "params": [
              {
                "name": "manu_batch_run_id",
                "value": "",
                "type": "path",
                "description": "ID of Manufacturing Run to return"
              }
            ]
          },
          "docs": "Get Manufacturing Run by ID"
        }
      ]
    }
  ],
  "bundled": true
}